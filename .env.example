# ---------------------------------------------------------------------------
# Шаблон для .env. Скопируй в .env (в той же папке, что docker-compose.yml),
# заполни нужное и перезапусти бэк:
#
#     copy .env.example .env       # Windows
#     cp   .env.example .env       # Linux/macOS
#     docker compose up -d --build backend
#
# .env уже в .gitignore — реальные ключи в репозиторий не уедут.
# Все переменные опциональны: если не задать, compose возьмёт дефолты
# из docker-compose.yml. Бэк всё равно стартует — но S3-фичи будут
# в fail-open режиме (uploads вернут 400 до настройки).
# ---------------------------------------------------------------------------

# === JWT ====================================================================
# Hex-строка длиной ≥ 64 символа (= 32 байта, минимум для HS256). Сгенерить
# можно командой: openssl rand -hex 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# === S3 (Yandex Object Storage / AWS native / MinIO / DO Spaces) =============
# AWS native:        endpoint можно НЕ указывать, region важен.
# Yandex Cloud:      endpoint = https://storage.yandexcloud.net, path-style = true
# DigitalOcean:      endpoint = https://<region>.digitaloceanspaces.com
# MinIO локально:    endpoint = http://localhost:9000, path-style = true

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=orta-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://orta-uploads.storage.yandexcloud.net
S3_PATH_STYLE=true

# === JVM ====================================================================
# Если бэк в Docker'е ловит OOM, подними -Xmx. На typical dev-машине достаточно.
JAVA_OPTS=-Xms256m -Xmx512m
